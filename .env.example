# Prisma Postgres (Vercel Storage → Prisma Postgres → Connect)
# Use the pooled URL the integration injects. If migrate fails, also set DIRECT_URL
# to the same credentials with host db.prisma.io instead of pooled.db.prisma.io.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Studio login at /studio/login
CHAT_ADMIN_PASSWORD="change-me"
CHAT_ADMIN_SECRET="generate-a-long-random-string"
