generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Question {
  id        String   @id @default(cuid())
  category  String
  prompt    String
  aliases   String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers Answer[]
  logs    ConversationLog[]

  @@index([category])
  @@index([active])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  variant    String   @default("default")
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
}

model FallbackLead {
  id           String   @id @default(cuid())
  name         String?
  email        String
  phone        String?
  topic        String?
  notes        String?  @db.VarChar(500)
  conversation Json?
  status       String   @default("new")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model ConversationLog {
  id          String    @id @default(cuid())
  sessionId   String
  asked       String    @db.VarChar(400)
  matchedId   String?
  question    Question? @relation(fields: [matchedId], references: [id], onDelete: SetNull)
  confidence  Float
  fallback    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([fallback])
  @@index([matchedId])
  @@index([sessionId])
}
